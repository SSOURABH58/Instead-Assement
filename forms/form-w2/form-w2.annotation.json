    {
      "id": "w2_box_15_state",
      "label": "Box 15: State (Array Index Resolution)",
      "type": "STRING",
      "dataPath": "financials.stateTaxes[0].state",
      "layoutStrategy": "SINGLE_BOX",
      "bounds": [{ "pageIndex": 0, "box": { "x": 40, "y": 280, "width": 30, "height": 14 }, "align": "CENTER" }]
    },
    {
      "id": "w2_box_16_state_wages",
      "label": "Box 16: State wages, tips, etc.",
      "type": "CURRENCY",
      "dataPath": "financials.stateTaxes[0].stateWages",
      "layoutStrategy": "SINGLE_BOX",
      "format": { "currency": { "roundToWholeDollar": false } },
      "bounds": [{ "pageIndex": 0, "box": { "x": 300, "y": 280, "width": 120, "height": 14 }, "align": "RIGHT" }]
    },
    {
      "id": "w2_box_17_state_tax",
      "label": "Box 17: State income tax",
      "type": "CURRENCY",
      "dataPath": "financials.stateTaxes[0].stateIncomeTax",
      "layoutStrategy": "SINGLE_BOX",
      "format": { "currency": { "roundToWholeDollar": false } },
      "bounds": [{ "pageIndex": 0, "box": { "x": 440, "y": 280, "width": 120, "height": 14 }, "align": "RIGHT" }]
    }
  ]
}
